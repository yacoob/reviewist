{
  "name": "reviewist",
  "version": "0.0.1",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tsconfig/svelte": "^5.0.8",
    "@types/bun": "^1.3.11",
    "@types/node": "^22.19.13",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^10.0.2",
    "eslint-plugin-svelte": "^3.15.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.3.0",
    "jsdom": "^28.1.0",
    "sharp": "^0.34.5",
    "svelte": "^5.53.3",
    "svelte-check": "^4.4.3",
    "to-ico": "^1.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.18"
  },
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "eslint src/ tests/",
    "validate": "vitest run --coverage && svelte-check --tsconfig ./tsconfig.json && eslint src/ tests/",
    "bench": "bun tests/reconcile.bench.ts",
    "compile": "bun build --compile src/cli.ts --outfile reviewist-export",
    "clean": "rm -rf dist node_modules/.vite",
    "raze": "rm -rf dist node_modules coverage"
  },
  "type": "module"
}